// Prisma schema for the agents console (PostgreSQL).
//
// Accounts, sessions and organizations live in Keycloak (ADR 0007): this app keeps no user or session tables.
// What remains is the per-user OAuth credentials of third-party connectors (Spotify, Google Workspace), keyed by the
// Keycloak user id (`sub`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// OAuth credentials of connectors (encrypted)
model UserCredential {
  id           String    @id @default(uuid())
  userId       String    @map("user_id") // the Keycloak user id (`sub`)
  provider     String    // 'spotify', 'google_workspace'
  accessToken  String    @map("access_token") // AES-256 encrypted
  refreshToken String?   @map("refresh_token") // AES-256 encrypted
  tokenType    String?   @map("token_type")
  expiresAt    DateTime? @map("expires_at")
  scope        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_credentials")
}

  class ExecutionBudget {
    max_tokens   : int | None
    max_cost_usd : float | None
    max_turns    : int | None
    deadline_s   : float | None
  }
  class Supervision {
    run_id           : str
    session_id       : str
    root_id          : AgentId
    parent_id        : AgentId | None
    depth            : int
    spawn_budget     : SpawnBudget
    execution_budget : ExecutionBudget
    priority         : Priority
    retention        : HistoryRetention
    root(...)
    spawn_child(...)
  }
  class RunContext {
    run_id       : str
    trace_id     : str
    deadline     : datetime | None
    supervision  : Supervision | None
    cancellation : CancellationToken
    check() / is_expired()
  }
  interface Middleware
}

note right of SpawnBudget
  RESOLVED — Supervision v2:
  Old: Supervision.max_agents: int = 50
  New: spawn_budget: SpawnBudget (frozen, tree-wide)
       execution_budget: ExecutionBudget (frozen, per-agent)
  L1 SpawnTracker: mutable headcount (reads spawn_budget).
  L1 ExecutionTracker: mutable token/cost/turn (reads execution_budget).
  spawn_child() propagates spawn_budget unchanged;
  execution_budget can be overridden per child.
end note

note right of RunContext
  RESOLVED — GAP 4:
  run_id is now a direct field on RunContext.
  Populated from supervision.run_id when set;
  standalone() generates a fresh ULID.
  check() raises CancellationError when
  token is cancelled or deadline passed.
end note

' ================================================================
' BLOCK 7: kernel/runtime/  — STABLE (Stage 0 done)
' ================================================================
package "kernel/runtime/  — Stage 0 COMPLETE\nids · log_entry · effects · inbox · scheduler · supervisor · …" as PKG_RUNTIME #dcfce7 {
  class RunId
  class RunStatus
  interface EventLog {
    append(run_id, entry, expected_seq) : int
    read(run_id, from_seq)
    tail(run_id, from_seq)
    last_seq(run_id) : int
  }
  interface Journal {
    record(result)
    lookup(effect_id) : EffectResult | None
  }
  interface Inbox {
    deliver(agent_id, msg)
    drain(agent_id) : list[Message]
  }
  interface Scheduler {
    enqueue(run_id, priority, tenant)
    lease(worker_id, capacity) : list[Lease]
    release(lease, status)
  }
  interface Supervisor {
    spawn(agent_id, parent, supervision, boot)
    cancel(handle, reason)
    join(handle) : RunResult
  }
  interface DurableAgent {
    id  : AgentId
    run(ctx, inbox)
  }
  interface FollowGraph
  interface FanoutStrategy
  interface SignalBus
}

note right of EventLog
  RESOLVED — GAPs 1, 2, 3:
  GAP 1 (God-object): AgentRuntime split into
    EventLog + Inbox + FollowGraph + Scheduler + SignalBus.
  GAP 2 (sync contract): DurableAgent.run(ctx, inbox)
    replaced on_message(). Can pause days for HITL.
  GAP 3 (state authority): EventLog is truth.
    State = fold(log). No save_state/load_state.
    Checkpoint demotes to log-compaction hint.
  EventLog uses optimistic-concurrency seq:
    ConcurrentAppendError on race.
  Stage 0: all in-memory (asyncio).
  Stage 1: Postgres (EventLog + Journal + Scheduler)
            + Redis (Inbox + SignalBus).
end note


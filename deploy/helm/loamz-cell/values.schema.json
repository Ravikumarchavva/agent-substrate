{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["mode", "publicUrls"],
  "properties": {
    "mode": { "enum": ["monolith", "microservices"] },
    "publicUrls": {
      "type": "object",
      "required": ["keycloak", "ui", "dataWeb", "agentApi", "dataApi"],
      "properties": {
        "keycloak": { "type": "string", "pattern": "^https?://" },
        "ui": { "type": "string", "pattern": "^https?://" },
        "dataWeb": { "type": "string", "pattern": "^https?://" },
        "agentApi": { "type": "string", "pattern": "^https?://" },
        "dataApi": { "type": "string", "pattern": "^https?://" },
        "s3": { "type": "string" }
      }
    },
    "postgres": { "type": "object", "properties": { "external": { "type": "object", "properties": { "sslmode": { "enum": ["require", "verify-ca", "verify-full"] } } } } },
    "agent": { "type": "object", "properties": { "sandbox": { "type": "object", "properties": { "runtime": { "enum": ["k8s", "nsjail"] } } } } }
  }
}

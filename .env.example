# Copy to .env and fill in. No inline comments after values (python-dotenv passes the whole line to Pydantic).

# ── Models & API keys ──
CHAT_MODEL=openai/gpt-5.4-mini
AGENT_MODE=react
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# ── Web search ──
EXA_API_KEY=
TAVILY_API_KEY=

# ── PostgreSQL ──
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentdb
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentdb
APP_DATABASE_URL=
RLS_APP_ROLE_PASSWORD=

# ── Redis & sessions ──
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=3600
SESSION_MAX_MESSAGES=200
SESSION_AUTO_CHECKPOINT=50

# ── Object storage (SeaweedFS) ──
FILE_STORE_BACKEND=s3
FILE_STORE_ENDPOINT=http://localhost:8333
FILE_STORE_BUCKET=agent-files
FILE_STORE_ACCESS_KEY=
FILE_STORE_SECRET_KEY=

# ── Documents (leave EMBEDDING_* empty for word-only knowledge-base search) ──
DOCUMENT_INTELLIGENCE_SERVICE_URL=
DOCUMENT_INTELLIGENCE_ENABLE_DOCUMENT_SECURITY_SCAN=true
EMBEDDING_RERANKER_SERVICE_URL=
EMBEDDING_MODEL=

# ── Auth & admin ──
JWT_SECRET=
ADMIN_EMAIL=

# ── Features ──
ENABLE_BUILDER=true
DISABLE_TOOL_APPROVALS=false

# ── Spotify ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

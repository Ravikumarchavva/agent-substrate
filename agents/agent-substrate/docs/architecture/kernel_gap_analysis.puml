' ================================================================
' Cross-package arrows (tell the story)
' ================================================================
' L1 implements kernel contracts
LocalRuntime      .up.> EventLog    : "implements (Stage 0)"
LocalRuntime      .up.> Inbox       : "implements"
LocalRuntime      .up.> Scheduler   : "implements"

' L1 reads kernel policy types
SpawnTracker      .up.> SpawnBudget     : "reads max_agents"
ExecutionTracker  .up.> ExecutionBudget : "reads limits"
ToolInvoker       .up.> BlobStore       : "offload large results"
ToolInvoker       .up.> ApprovalHandler : "HITL risk gate"

' DurableAgent interaction
DurableAgent      .up.> EventLog   : "folds on wake"
Inbox             ..>   DurableAgent : "drain() → inbox arg"
Scheduler         ..>   DurableAgent : "leases run"

' Stage 1 implements runtime contracts
PgEventLog     .up.> EventLog   : "implements"
PgJournal      .up.> Journal    : "implements"
PgScheduler    .up.> Scheduler  : "implements"
RedisInbox     .up.> Inbox      : "implements"
RedisSignalBus .up.> SignalBus  : "implements"


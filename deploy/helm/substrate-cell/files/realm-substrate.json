{
  "realm": "substrate",
  "displayName": "Substrate",
  "enabled": true,
  "organizationsEnabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "Operates the cell: all tenants, provisioning and erasure. Never granted to tenant users."
      },
      {
        "name": "tenant_admin",
        "description": "Administers one organization (tenant): members, agents, policies, grants."
      },
      {
        "name": "end_user",
        "description": "Uses the agents and data of the organization they belong to."
      }
    ],
    "client": {
      "agent-substrate": [
        {
          "name": "provision-tenant",
          "description": "Create and configure a tenant in the agent runtime (cell-admin)."
        },
        {
          "name": "erase-tenant",
          "description": "Erase all of a tenant's agent data (cell-admin)."
        }
      ],
      "substrate-data": [
        {
          "name": "provision-tenant",
          "description": "Create and configure a tenant in the data service (cell-admin)."
        },
        {
          "name": "erase-tenant",
          "description": "Erase all of a tenant's data (cell-admin)."
        }
      ]
    }
  },
  "groups": [
    {
      "name": "data-admins"
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "The `sub` claim and auth_time. Without it access tokens carry no subject.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "web-origins",
      "description": "Allowed web origins of the client, for CORS.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "acr",
      "description": "Authentication context class reference (level of assurance).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "acr loa level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Name and username.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "Email address.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm roles (realm_access.roles) and client roles (resource_access.<client>.roles).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "agents-api",
      "description": "Adds the agent-substrate audience to the access token.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "agent-substrate audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agent-substrate",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "data-api",
      "description": "Adds the substrate-data audience to the access token.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "substrate-data audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "substrate-data",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "organization",
      "description": "The organization (tenant) the token is for. Request `organization:<alias>` to pin exactly one.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization",
            "jsonType.label": "String",
            "multivalued": "true",
            "addOrganizationId": "true",
            "addOrganizationAttributes": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "groups",
      "description": "Group membership (group names without the leading slash are used by substrate-data).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "data:read",
      "description": "Run read-only SQL and browse the catalog.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "files:read",
      "description": "Read files in volumes.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "files:write",
      "description": "Write files in volumes.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "documents:read",
      "description": "Read documents.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "documents:write",
      "description": "Create and change documents.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "memory:read",
      "description": "Read agent memory.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "memory:write",
      "description": "Write agent memory.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "substrate-ui",
      "name": "Substrate agents console",
      "description": "Backend-for-frontend of the agents UI: confidential, authorization code + PKCE (S256).",
      "enabled": true,
      "publicClient": false,
      "secret": "${SUBSTRATE_UI_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${SUBSTRATE_UI_URL:http://127.0.0.1:3000}",
      "redirectUris": [
        "${SUBSTRATE_UI_URL:http://127.0.0.1:3000}/chat/auth/callback"
      ],
      "webOrigins": [
        "${SUBSTRATE_UI_URL:http://127.0.0.1:3000}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SUBSTRATE_UI_URL:http://127.0.0.1:3000}/chat/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "agents-api",
        "groups"
      ],
      "optionalClientScopes": [
        "organization",
        "data-api",
        "data:read",
        "files:read",
        "files:write",
        "documents:read",
        "documents:write",
        "memory:read",
        "memory:write"
      ]
    },
    {
      "clientId": "substrate-data-web",
      "name": "Substrate Data workspace",
      "description": "Backend-for-frontend of the data workspace: confidential, authorization code + PKCE (S256).",
      "enabled": true,
      "publicClient": false,
      "secret": "${SUBSTRATE_DATA_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${SUBSTRATE_DATA_WEB_URL:http://127.0.0.1:3011}",
      "redirectUris": [
        "${SUBSTRATE_DATA_WEB_URL:http://127.0.0.1:3011}/auth/callback"
      ],
      "webOrigins": [
        "${SUBSTRATE_DATA_WEB_URL:http://127.0.0.1:3011}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SUBSTRATE_DATA_WEB_URL:http://127.0.0.1:3011}/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "data-api",
        "groups"
      ],
      "optionalClientScopes": [
        "organization",
        "agents-api"
      ]
    },
    {
      "clientId": "agent-substrate",
      "name": "Agent runtime API",
      "description": "Resource server (audience) of the agents API. Never signs anyone in.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "substrate-data",
      "name": "Substrate Data API",
      "description": "Resource server (audience) of the data API. Never signs anyone in.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "cell-admin",
      "name": "Cell administration",
      "description": "Service account the platform uses to provision and erase tenants in this cell (client credentials).",
      "enabled": true,
      "publicClient": false,
      "secret": "${CELL_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "agents-api",
        "data-api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "substrate-cli",
      "name": "Substrate CLI and SDK",
      "description": "Public client for people at a terminal: OAuth 2.0 device authorization grant.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "agents-api",
        "data-api",
        "groups"
      ],
      "optionalClientScopes": [
        "organization",
        "data:read",
        "files:read",
        "files:write",
        "documents:read",
        "documents:write",
        "memory:read",
        "memory:write"
      ]
    },
    {
      "clientId": "agent-membership",
      "name": "Agent server membership check",
      "description": "Service account the agent server uses to confirm a user belongs to an organization before it mints a data token. Keycloak 26 serves organization membership only to manage-realm, so this client holds it: keep its secret on the agent server alone. Follow-up: replace with a narrower check (fine-grained admin permissions) when Keycloak offers one.",
      "enabled": true,
      "publicClient": false,
      "secret": "${AGENT_MEMBERSHIP_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-cell-admin",
      "enabled": true,
      "serviceAccountClientId": "cell-admin",
      "clientRoles": {
        "agent-substrate": [
          "provision-tenant",
          "erase-tenant"
        ],
        "substrate-data": [
          "provision-tenant",
          "erase-tenant"
        ]
      }
    },
    {
      "username": "service-account-agent-membership",
      "enabled": true,
      "serviceAccountClientId": "agent-membership",
      "clientRoles": {
        "realm-management": [
          "manage-realm"
        ]
      }
    }
  ]
}

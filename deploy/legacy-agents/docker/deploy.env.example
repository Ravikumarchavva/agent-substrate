# ─────────────────────────────────────────────────────────────────────────────
# Fill this in, save as `deploy.env`, then run:
#   docker compose --env-file deploy.env -f docker-compose.deploy.yml up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# Your domain (A record must point at the box's public IP). Caddy gets HTTPS
# for this automatically. Example: chat.yourname.com
DOMAIN=

# ── Secrets — generate each with:  openssl rand -hex 32 ──────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
NEXTAUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Your email — grants access to the /admin pages.
ADMIN_EMAIL=

# ── LLM provider — set ONE key and point CHAT_MODEL at it ────────────────────
# Free-tier friendly options (recommended to keep running cost ~$0):
#   Groq:   CHAT_MODEL=groq/llama-3.3-70b-versatile   + GROQ_API_KEY
#   Gemini: CHAT_MODEL=google/gemini-2.5-flash         + GEMINI_API_KEY
# Or paid: CHAT_MODEL=openai/gpt-5.4-mini              + OPENAI_API_KEY
CHAT_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Google login (optional — leave blank to run without OAuth) ───────────────
# Without these, everyone shares the "substrate-ui" service account identity.
# Authorized redirect URI in Google console: https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

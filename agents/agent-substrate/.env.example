# Copy to .env and fill in. No inline comments after values (python-dotenv passes the whole line to Pydantic).

# ── Models & API keys ──
CHAT_MODEL=openai/gpt-5.4-mini
AGENT_MODE=react
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# ── Web search ──
EXA_API_KEY=
TAVILY_API_KEY=

# ── PostgreSQL ──
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentdb
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentdb
APP_DATABASE_URL=
RLS_APP_ROLE_PASSWORD=

# ── Redis & sessions ──
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=3600
SESSION_MAX_MESSAGES=200
SESSION_AUTO_CHECKPOINT=50

# ── Files ──
# Empty keeps files in a folder on this machine. With a Substrate Data service, files are its governed, versioned Files domain and this
# process holds no object-store credentials (https:// unless the service is on localhost). Register this platform on the data service as a
# trusted issuer named DATA_FILES_TOKEN_ISSUER (read_only=false) with the keys served at /.well-known/data-token-jwks.json.
DATA_SERVICE_URL=
# DATA_FILES_TOKEN_ISSUER=agent-substrate-files
# Optional: an OIDC client in the data-admins group, for the admin storage page (tenant usage and volume quotas).
# DATA_ADMIN_OIDC_ISSUER=
# DATA_ADMIN_CLIENT_ID=
# DATA_ADMIN_CLIENT_SECRET=

# ── Documents (leave EMBEDDING_* empty for word-only knowledge-base search) ──
DOCUMENT_INTELLIGENCE_SERVICE_URL=
DOCUMENT_INTELLIGENCE_ENABLE_DOCUMENT_SECURITY_SCAN=true
EMBEDDING_RERANKER_SERVICE_URL=
EMBEDDING_MODEL=
# A model writes what each section says, a card per document and (knowledge bases) its topic, in the background after an upload.
# Empty model = CHAT_MODEL. No key for it = no descriptions (nothing else changes). Daily cap is per tenant, in tokens; 0 = none.
DOCUMENT_SUMMARY_ENABLED=true
DOCUMENT_SUMMARY_MODEL=
DOCUMENT_SUMMARY_DAILY_TOKENS=5000000
# Email scheduled-task results (Resend); empty = in-app notifications only
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# ── Identity (Keycloak realm; every request carries one of its access tokens) ──
OIDC_ISSUER=
OIDC_AUDIENCE=agent-substrate
# Organization-membership check before the per-run data token is signed (a realm service account with view-users)
OIDC_ADMIN_CLIENT_ID=
OIDC_ADMIN_CLIENT_SECRET=

# ── Admin ──
ADMIN_EMAIL=

# ── Data platform for the code interpreter (Substrate Data, on another machine; empty URL = off) ──
# The backend and sandbox Python need substrate-data-client installed (substrate-data/client).
# The data service must be https:// (plain http only to localhost). It fetches this backend's public keys from
# /.well-known/data-token-jwks.json: put that address in its SUBSTRATE_DATA_TRUSTED_ISSUERS (logged at startup).
DATA_SERVICE_URL=
# CA that signed the data service's certificate (system store when empty), and a client certificate for mutual TLS
# DATA_SERVICE_CA_FILE=
# DATA_CLIENT_CERT_FILE=
# DATA_CLIENT_KEY_FILE=
# DATA_TOKEN_ISSUER=agent-substrate
# DATA_TOKEN_AUDIENCE=substrate-data
# DATA_TOKEN_KEY_FILE=
# DATA_RELAY_DIR=

# ── Features ──
ENABLE_BUILDER=true
DISABLE_TOOL_APPROVALS=false

# ── Spotify ──
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

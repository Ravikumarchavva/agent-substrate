}

' ================================================================
' Vertical stacking (hidden arrows force top-to-bottom layout)
' ================================================================
PKG_DATA   -[hidden]-> PKG_MSG
PKG_MSG    -[hidden]-> PKG_TOOLS
PKG_TOOLS  -[hidden]-> PKG_CHAIN
PKG_CHAIN  -[hidden]-> PKG_CAP
PKG_CAP    -[hidden]-> PKG_KG

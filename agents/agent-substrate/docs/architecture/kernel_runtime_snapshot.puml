@startuml kernel_runtime_snapshot
title Ravi Engine - One Request, Object by Object\n(what exists at runtime for a single user message that triggers a tool call)

top to bottom direction
skinparam dpi 200
skinparam Shadowing false
skinparam DefaultFontName "Segoe UI"

skinparam BackgroundColor #ffffff
skinparam TitleFontColor #111827
skinparam TitleFontSize 15

skinparam ObjectBackgroundColor #ffffff
skinparam ObjectBorderColor #4b5563
skinparam ObjectFontColor #111827
skinparam ObjectAttributeFontColor #4b5563
skinparam ObjectAttributeFontSize 11

skinparam ArrowColor #4b5563
skinparam ArrowFontColor #374151
skinparam ArrowFontSize 11

skinparam NoteBorderColor #f59e0b
skinparam NoteBackgroundColor #fef3c7
skinparam NoteFontColor #78350f
skinparam NoteFontSize 11

' MESSAGE ARRIVES
object "msg : ChatMessage" as msg {
  role    = "user"
  content = [TextBlock("research quantum compute")]
}

' RUNTIME STAMPS AND DISPATCHES
object "runtime : LocalRuntime" as rt {
  worker_id = "worker-01"
}

object "ctx : RunContext" as ctx {
  run_id   = "run-3a7c"
  trace_id = "t-9b1e"
  deadline = "12:35:00"
}

' AGENT THINKS
object "agent : ReActAgent" as agent {
  id = "research-01"
}

object "llm : OpenAIChatClient" as llm {
  model = "gpt-4o"
}

object "resp1 : LLMResponse" as resp1 {
  content      = [ToolUseBlock]
  usage.tokens = 842
}

object "toolCall : ToolUseBlock" as toolcall {
  id    = "call-88fa"
  name  = "web_search"
  input = {q: "quantum compute 2025"}
}

' TOOL RUNS THROUGH INVOKER
object "invoker : ToolInvoker" as invoker {
  policy.max_risk  = SAFE
  policy.timeout_s = 60
}

object "toolResult : ToolResultBlock" as toolresult {
  tool_use_id = "call-88fa"
  content     = [TextBlock("IBM 1000-qubit...")]
}

' FINAL LLM CALL WITH FULL CONTEXT
object "resp2 : LLMResponse" as resp2 {
  content            = [TextBlock("Summary: ...")]
  usage.total_tokens = 1166
}

' FLOW
msg        --> rt          : "1. ingested by"
rt         --> ctx         : "2. stamps run context"
rt         --> agent       : "3. dispatches to"
ctx        ..>  agent      : "threaded into every call"

agent      --> llm         : "4. generate(history + msg)"
llm        --> resp1       : "5. tool call requested"
resp1      --> toolcall    : "6. contains"

toolcall   --> invoker     : "7. routed through ToolInvoker"
invoker    --> toolresult  : "8. executes tool -> result"

note right of invoker
  Enforces: ToolRisk gate, HITL approval,
  per-call timeout, call budget.
  Resolves {"$artifact": ref} args
  server-side before execute().
end note

agent      --> llm         : "9. generate(history + tool result)"
llm        --> resp2       : "10. final response"

note right of resp2
  Returned to the caller.
  The full round-trip - including
  the tool call - was one agent turn.
end note

@enduml

@startuml kernel_gap_analysis
title Kernel L0: Current State vs Both Plans\n[Green = plan done | Blue = Stage 0 to add | Orange = needs change | Red = replace/demote | Notes = gaps and conflicts]

top to bottom direction
skinparam dpi 200
skinparam Shadowing false
skinparam DefaultFontName "Segoe UI"
hide empty members
hide stereotypes

skinparam ClassBackgroundColor #ffffff
skinparam ClassBorderColor #4b5563
skinparam ClassFontColor #111827
skinparam ClassFontSize 11

skinparam InterfaceBackgroundColor #eff6ff
skinparam InterfaceBorderColor #3b82f6
skinparam InterfaceFontColor #1e3a8a

skinparam PackageFontColor #374151
skinparam PackageFontSize 10

skinparam ArrowColor #6b7280
skinparam ArrowFontColor #374151
skinparam ArrowFontSize 10

skinparam NoteBorderColor #d97706
skinparam NoteBackgroundColor #fef3c7
skinparam NoteFontColor #78350f
skinparam NoteFontSize 10


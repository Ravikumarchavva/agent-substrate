{
  "name": "substrate-data-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3011",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3011",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "node scripts/prepare-editor.mjs",
    "format": "prettier --write app components hooks lib scripts *.json *.mjs next.config.ts",
    "format:check": "prettier --check app components hooks lib scripts *.json *.mjs next.config.ts",
    "test:browser": "node scripts/browser-smoke.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/react-virtual": "^3.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "lucide-react": "^0.577.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}

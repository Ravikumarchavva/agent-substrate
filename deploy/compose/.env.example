# Substrate cell, self-host bundle. Copy to .env (or run ./gen-env.sh, which fills every secret below with random
# values) and edit. .env is git-ignored; never commit it. Every value marked "secret" must be unique per cell.

# ── Images ────────────────────────────────────────────────────────────────────
# Leave as is to build from this checkout (`docker compose build`); set IMAGE_REGISTRY/IMAGE_TAG to pull released images.
IMAGE_REGISTRY=ghcr.io/agent-substrate
IMAGE_TAG=local
COMPOSE_PROJECT_NAME=substrate-cell

# ── Where the cell is reachable ───────────────────────────────────────────────
# Browsers and containers must see the SAME Keycloak address (it is the token issuer). The default needs one line in
# the hosts file of the machine running the browser:   127.0.0.1 keycloak
# Behind a real domain, put your public URLs here (and see Caddyfile).
KEYCLOAK_PUBLIC_URL=http://keycloak:8080
SUBSTRATE_UI_URL=http://localhost:3000
SUBSTRATE_DATA_WEB_URL=http://localhost:3011
# Where browsers reach object storage (presigned upload/download URLs).
S3_PUBLIC_URL=http://localhost:8333
# Published ports bind here. Keep 127.0.0.1 unless a reverse proxy or firewall is in front.
BIND_ADDR=127.0.0.1

# ── Database and cache (secret) ───────────────────────────────────────────────
POSTGRES_USER=substrate
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Keycloak (secret) ─────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# Substituted into the realm on first import (deploy/keycloak/realm-substrate.json). Unset = literal "${...}" secret!
SUBSTRATE_UI_CLIENT_SECRET=
SUBSTRATE_DATA_WEB_CLIENT_SECRET=
CELL_ADMIN_CLIENT_SECRET=

# ── Object storage (SeaweedFS, S3 API). One identity per service (secret) ─────
WAREHOUSE_BUCKET=warehouse
STAGING_BUCKET=substrate-staging
VOLUMES_BUCKET=substrate-volumes
AGENTS_BUCKET=agent-files
CONTROL_S3_ACCESS_KEY_ID=
CONTROL_S3_SECRET_ACCESS_KEY=
WORKER_S3_ACCESS_KEY_ID=
WORKER_S3_SECRET_ACCESS_KEY=
AGENTS_S3_ACCESS_KEY_ID=
AGENTS_S3_SECRET_ACCESS_KEY=

# ── substrate-data (secret) ───────────────────────────────────────────────────
# 32+ characters each; the controller's own token, and the one it presents to workers.
CONTROLLER_TOKEN=
WORKER_TOKEN=
WEB_SESSION_SECRET=
MASK_SALT=
SUBSTRATE_DATA_WORKER_MEMORY_LIMIT=2GB

# ── Agent server (secret) ─────────────────────────────────────────────────────
UI_SESSION_SECRET=
# Mode of the agent server is chosen by the compose profile (monolith | microservices), not here.
# nsjail needs extra privileges (see compose.yml); "k8s" is for Kubernetes only.
SANDBOX_RUNTIME=nsjail
CHAT_MODEL=google/gemini-3.1-flash-lite
# At least one model provider key. Leave the others empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Host ports (deploy/PORTS.md is the registry; change here, nowhere else) ───
PORT_AGENT=8000
PORT_UI=3000
PORT_DATA_WEB=3011
PORT_DATA_API=8020
PORT_KEYCLOAK=8080
PORT_S3=8333

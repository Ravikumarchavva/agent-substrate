@startuml kernel_domain_model
title Ravi Engine — Kernel Domain Model (L0)\nSubpackage layout after June 2026 reorganisation.\nAll items are Protocols, frozen dataclasses, or value types — zero I/O.

top to bottom direction
skinparam dpi 200
skinparam Shadowing false
skinparam DefaultFontName "Segoe UI"
hide empty members
hide stereotypes

skinparam BackgroundColor #ffffff
skinparam TitleFontColor #111827
skinparam TitleFontSize 14

skinparam PackageBackgroundColor #f9fafb
skinparam PackageBorderColor #d1d5db
skinparam PackageFontColor #374151
skinparam PackageFontSize 11

skinparam ClassBackgroundColor #ffffff
skinparam ClassBorderColor #4b5563
skinparam ClassFontColor #111827
skinparam ClassFontSize 12

skinparam InterfaceBackgroundColor #eff6ff
skinparam InterfaceBorderColor #3b82f6
skinparam InterfaceFontColor #1e3a8a

skinparam ArrowColor #4b5563
skinparam ArrowFontColor #374151
skinparam ArrowFontSize 11

skinparam NoteBorderColor #f59e0b
skinparam NoteBackgroundColor #fef3c7
skinparam NoteFontColor #78350f
skinparam NoteFontSize 11

' ══════════════════════════════════════════════════════════════
' CORE  — fundamental primitives, no kernel-internal deps
' ══════════════════════════════════════════════════════════════
package "core/  (identity · content · errors · usage)" as PKG_CORE {
  class AgentId {
    type : str
    key  : str
  }
  class TopicId {
    type   : str
    source : str
  }
  abstract class ContentBlock
  class TextBlock
  class ImageBlock
  class ToolUseBlock {
    id    : str
    name  : str
    input : JsonObject
  }
  class ToolResultBlock {
    tool_use_id : str
    content     : list[ContentBlock]
  }
  class ChatMessage {
    role    : "user" | "assistant" | "tool"
    content : list[ContentBlock]
  }
  class Usage {
    input_tokens  : int
    output_tokens : int
  }

  ContentBlock <|-- TextBlock
  ContentBlock <|-- ImageBlock
  ContentBlock <|-- ToolUseBlock
  ContentBlock <|-- ToolResultBlock
  ChatMessage  *-- ContentBlock : "1..*"
}

' ══════════════════════════════════════════════════════════════
' MESSAGING  — agent ↔ agent wire types
' ══════════════════════════════════════════════════════════════
package "messaging/  (message · events · stream)" as PKG_MESSAGING {
  class Message {
    id             : str
    target         : AgentId | TopicId
    payload        : Payload
    reply_to       : str | None
    correlation_id : str
  }
  abstract class Payload
  class DataPayload
  class ChatPayload
  class ControlPayload
  class Subscription {
    topic    : TopicId
    agent_id : AgentId
  }
  class Event {
    id             : str
    type           : str
    source         : AgentId
    schema_version : int
    data           : JsonObject
  }
  class AgentProgress {
    run_id : str
    step   : AgentStep
    seq    : int
  }

  Payload <|-- DataPayload
  Payload <|-- ChatPayload
  Payload <|-- ControlPayload
  Message *-- Payload
}

' ══════════════════════════════════════════════════════════════
' LLM  — LLM client contracts
' ══════════════════════════════════════════════════════════════
package "llm/  (llm)" as PKG_LLM {
  interface LLMClient {
    generate(messages, options) : LLMResponse
    generate_stream(...)
  }
  interface EmbeddingClient {
    embed(texts) : EmbeddingResult
  }
  class LLMResponse {
    content : list[ContentBlock]
    usage   : Usage
  }
  class GenerationOptions {
    model        : str | None
    temperature  : float | None
    max_tokens   : int | None
    tools        : list[AnyTool] | None
  }
}

' ══════════════════════════════════════════════════════════════
' STORAGE  — persistence / retrieval protocols
' ══════════════════════════════════════════════════════════════
package "storage/  (blob · history · vector · graph · memory)" as PKG_STORAGE {
  interface BlobStore {
    store(data, content_type) : str
    resolve(ref) : bytes
    pin(ref) / unpin(ref)
  }
  interface HistoryProvider {
    get_messages(agent_id, session_id) : list[ChatMessage]
    append / clear
  }
  interface VectorStore {
    upsert(docs) / search(query, top_k) : list[SearchResult]
  }
  interface GraphStore {
    upsert_entity / upsert_relationship
    query(cypher) : SubGraph
  }
  interface ShortTermMemory
  interface LongTermMemory
}

note right of BlobStore
  Stage 0: in-memory dict
  Stage 1: MinIO / S3 adapter
  Used by: ToolInvoker (L1),
  chain tools (L2)
end note

' ══════════════════════════════════════════════════════════════
' TOOLS  — tool taxonomy + chain contracts
' ══════════════════════════════════════════════════════════════
package "tools/  (tools · skills · approval · chain)" as PKG_TOOLS {
  interface Tool {
    name         : str
    input_schema : JsonObject
    execute(...)
  }
  interface HostedTool {
    provider_specs : dict[str, JsonObject]
  }
  interface ProviderDefinedTool {
    provider_specs : dict[str, JsonObject]
    call_types     : tuple[str, ...]
    handle_call(call)
  }
  class ToolCallRequest {
    name      : str
    arguments : JsonObject
  }
  class ToolExecutionResult {
    content    : list[ContentBlock]
    structured : JsonObject
    is_error   : bool
  }
  class FunctionSpec {
    kind       = "function"
    name       : str
    parameters : JsonObject
    strict     : bool
  }
  class ProviderSpec {
    kind     = "provider"
    provider : str
    spec     : JsonObject
  }
  interface ApprovalHandler {
    request(req) : ApprovalDecision
  }
  class ChainPolicy {
    max_tool_calls          : int = 50
    call_timeout_s          : float = 60
    approval_timeout_s      : float = 55
    max_inline_result_bytes : int = 4096
    max_risk_unapproved     : ToolRisk
  }
  class InvocationResult {
    status       : "ok" | "error" | "denied"
    text         : str
    artifact_ref : str | None
  }
  class ChainRunResult {
    status     : "ok" | "error" | "timeout"
    tool_calls : int
    call_trace : list[ChainCallRecord]
  }
}

note bottom of PKG_TOOLS
  AnyTool = Tool | HostedTool | ProviderDefinedTool
  ToolSpec = FunctionSpec | ProviderSpec  (discriminated on "kind")
  spec_of(tool, provider=)  →  ToolSpec | None
  ArtifactStore alias removed; use BlobStore from storage/
end note

' ══════════════════════════════════════════════════════════════
' AGENT  — agent execution contracts
' ══════════════════════════════════════════════════════════════
package "agent/  (supervision · context · middleware · runtime_context)" as PKG_AGENT {
  class SpawnBudget {
    max_agents    : int = 50
    allow_preempt : bool = True
  }
  class ExecutionBudget {
    max_tokens   : int | None
    max_cost_usd : float | None
    max_turns    : int | None
    deadline_s   : float | None
  }
  class Supervision {
    run_id           : str
    session_id       : str
    root_id          : AgentId
    parent_id        : AgentId | None
    depth            : int
    spawn_budget     : SpawnBudget
    execution_budget : ExecutionBudget
    priority         : Priority
    retention        : HistoryRetention
    root(agent_id, ...)
    spawn_child(parent_id, ...)
    progress_topic   : TopicId
  }
  class RunContext {
    run_id      : str
    trace_id    : str
    deadline    : datetime | None
    tenant_id   : str | None
    cancellation: CancellationToken
    supervision : Supervision | None
    check()
    is_expired() : bool
    standalone(...)
  }
  interface Middleware
  interface AgentContextProtocol

  Supervision *-- SpawnBudget
  Supervision *-- ExecutionBudget
}

note right of SpawnBudget
  Frozen policy (kernel).
  L1 SpawnTracker holds the
  mutable count + paused set.
end note

note right of ExecutionBudget
  Frozen policy (kernel).
  L1 ExecutionTracker tracks
  consumed tokens / cost / turns.
end note

' ══════════════════════════════════════════════════════════════
' RUNTIME  — durable runtime contracts
' ══════════════════════════════════════════════════════════════
package "runtime/  (ids · log_entry · effects · inbox · scheduler · supervisor · …)" as PKG_RUNTIME {
  class RunId
  interface EventLog {
    append(run_id, entry, expected_seq) : int
    read(run_id, from_seq) : AsyncIterator
    tail(run_id, from_seq) : AsyncIterator
    last_seq(run_id) : int
  }
  interface Journal {
    record(result) / lookup(effect_id) : EffectResult | None
  }
  interface Inbox {
    deliver(agent_id, msg)
    drain(agent_id) : list[Message]
  }
  interface Scheduler {
    enqueue(run_id, priority, tenant)
    lease(worker_id, capacity) : list[Lease]
    release(lease, status)
  }
  interface Supervisor {
    spawn(agent_id, parent, supervision, boot) : RunHandle
    cancel(handle, reason)
    join(handle) : RunResult
  }
  interface DurableAgent {
    id  : AgentId
    run(ctx, inbox)
  }
  interface FollowGraph
  interface FanoutStrategy
  interface SignalBus
}

note bottom of PKG_RUNTIME
  EventLog: optimistic-concurrency fencing via
  expected_seq → raises ConcurrentAppendError on race.
  tail() = live view used by SSE Gateway.
  Stage 0: all in-memory (asyncio).
  Stage 1: Postgres (scheduler + journal + event_log)
           + Redis (inbox + signal_bus).
end note

' ══════════════════════════════════════════════════════════════
' Cross-package dependency arrows
' ══════════════════════════════════════════════════════════════
PKG_CORE     -[hidden]-> PKG_MESSAGING
PKG_MESSAGING -[hidden]-> PKG_LLM
PKG_LLM      -[hidden]-> PKG_STORAGE
PKG_STORAGE  -[hidden]-> PKG_TOOLS
PKG_TOOLS    -[hidden]-> PKG_AGENT
PKG_AGENT    -[hidden]-> PKG_RUNTIME

' Core → everything
Message      ..> AgentId      : "target / reply_to"
Subscription ..> TopicId      : "topic"
LLMResponse  *-- ContentBlock : "content"
LLMResponse  *-- Usage

' LLM uses content + usage from core
LLMClient    ..> ChatMessage  : "generate(messages)"
LLMClient    ..> LLMResponse  : "returns"

' Storage uses core
HistoryProvider ..> ChatMessage : "stores / returns"

' Tools use content
Tool       ..> ToolExecutionResult : "execute() returns"
ToolUseBlock ..> ToolCallRequest   : "translated to"

' Chain uses blob store
InvocationResult ..> BlobStore : "refs when result large"

' Agent uses core + runtime
Supervision ..> AgentId : "root_id, parent_id"
RunContext   ..> Supervision : "optional"
DurableAgent ..> EventLog    : "folds log on wake"
Inbox        ..> DurableAgent : "drain() → inbox arg"
Scheduler    ..> DurableAgent : "leases run"

@enduml

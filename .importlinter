# Loamz dependency rules (docs/rewrite/principles). Run: uv run lint-imports --config .importlinter
[importlinter]
root_packages =
    loamz
include_external_packages = False
# An import made only for type checking never runs, so it cannot drag a layer along.
exclude_type_checking_imports = True

[importlinter:contract:storage-is-the-bottom]
name = loamz.data.storage imports no other Loamz package
type = forbidden
source_modules =
    loamz.data.storage
forbidden_modules =
    loamz.agents
    loamz.data.server
    loamz.data.client
    loamz.identity

[importlinter:contract:identity-stands-alone]
name = loamz.identity imports no other Loamz package
type = forbidden
source_modules =
    loamz.identity
forbidden_modules =
    loamz.agents
    loamz.data

[importlinter:contract:data-never-imports-agents]
name = Loamz Data never imports Loamz Agents (agents are built on data, never the reverse)
type = forbidden
source_modules =
    loamz.data
forbidden_modules =
    loamz.agents

[importlinter:contract:client-is-light]
name = loamz.data.client depends on nothing but identity
type = forbidden
source_modules =
    loamz.data.client
forbidden_modules =
    loamz.data.server
    loamz.data.storage

[importlinter:contract:agents-layers]
name = loamz.agents layers point downward
type = layers
layers =
    loamz.agents.server
    loamz.agents.features
    loamz.agents.bootstrap
    loamz.agents.data | loamz.agents.toolkit | loamz.agents.providers
    loamz.agents.stores
    loamz.agents.kernel


[importlinter:contract:kernel-concepts]
name = the kernel's concepts only import downward
type = layers
layers =
    loamz.agents.kernel.wire | loamz.agents.kernel.events
    loamz.agents.kernel.agents
    loamz.agents.kernel.runtime
    loamz.agents.kernel.middleware
    loamz.agents.kernel.context
    loamz.agents.kernel.safety
    loamz.agents.kernel.ports
    loamz.agents.kernel.models
    loamz.agents.kernel.tools
    loamz.agents.kernel.telemetry
    loamz.agents.kernel.types
    loamz.agents.kernel.errors | loamz.agents.kernel.version | loamz.agents.kernel.caller

[importlinter:contract:kernel-is-the-engine]
name = the kernel imports nothing of loamz.agents outside it, and no vendor
type = forbidden
source_modules =
    loamz.agents.kernel
forbidden_modules =
    loamz.agents.stores
    loamz.agents.providers
    loamz.agents.toolkit
    loamz.agents.testing
    loamz.agents.evals
    loamz.agents.console
    loamz.agents.cli
    loamz.data.client

[importlinter:contract:data-server-layers]
name = loamz.data.server layers point downward (the kernel knows no feature)
type = layers
layers =
    loamz.data.server.cli
    loamz.data.server.app
    loamz.data.server.features
    loamz.data.server.kernel


      "component": "substrate-cloud"
    },
    "agents/substrate-ui": {
      "release-type": "node",
      "package-name": "substrate-ui",
      "component": "substrate-ui"
    },
    "data/substrate-data": {
      "release-type": "python",
      "package-name": "substrate-data",
      "component": "substrate-data"
    },
    "data/substrate-data-client": {
      "release-type": "python",
      "package-name": "substrate-data-client",
      "component": "substrate-data-client"
    },
    "data/substrate-data-web": {
      "release-type": "node",
      "package-name": "substrate-data-web",
      "component": "substrate-data-web"
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    "server/engine": {
      "release-type": "python",
      "package-name": "loamz-engine",
      "component": "loamz-engine"
    },
    "server/server": {
      "release-type": "python",
      "package-name": "loamz-server",
      "component": "loamz-server"
    },
    "server/reader": {
      "release-type": "python",
      "package-name": "loamz-reader",
      "component": "loamz-reader"
    },
    "sdk/python/core": {
      "release-type": "python",
      "package-name": "loamz-core",
      "component": "loamz-core"
    },
    "sdk/python/data": {
      "release-type": "python",
      "package-name": "loamz-data",
      "component": "loamz-data"
    },
    "meta/loamz": {
      "release-type": "python",
      "package-name": "loamz",
      "component": "loamz"
    }
  }
}

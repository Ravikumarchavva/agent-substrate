# `make up` runs scripts/bootstrap.py, which writes a private .env (mode 0600) with generated secrets.
# This file documents the variables; never commit a real .env.

# --- control plane (API and controller)
SUBSTRATE_DATA_METADATA=.workspace/control/catalog.sqlite
SUBSTRATE_DATA_CONTROLLER_STATE=.workspace/control/compute
SUBSTRATE_DATA_CONTROLLER_URL=http://127.0.0.1:8014
# 32+ chars; the controller's own secret
SUBSTRATE_DATA_CONTROLLER_TOKEN=
# control plane only
SUBSTRATE_DATA_TICKET_PRIVATE_KEY_FILE=.workspace/keys/ticket.pem

# --- identity (OIDC)
SUBSTRATE_DATA_OIDC_ISSUER=http://127.0.0.1:18080/realms/substrate
SUBSTRATE_DATA_OIDC_AUDIENCE=substrate-data
SUBSTRATE_DATA_ADMIN_GROUP=data-admins

# --- storage: SeaweedFS S3 + Iceberg REST catalog. Each process uses its own S3 identity.
SUBSTRATE_DATA_S3_ENDPOINT_URL=http://127.0.0.1:18333
SUBSTRATE_DATA_ICEBERG_CATALOG_URL=http://127.0.0.1:18181
SUBSTRATE_DATA_WAREHOUSE=warehouse
SUBSTRATE_DATA_STAGING_BUCKET=substrate-staging
# same value on control plane, controller and every worker
SUBSTRATE_DATA_STORAGE_ID=dev-warehouse
# Control plane identity: catalog commits and upload signing.
# SUBSTRATE_DATA_S3_ACCESS_KEY_ID=
# SUBSTRATE_DATA_S3_SECRET_ACCESS_KEY=

# --- a worker (set where the compute is operated, e.g. container env; never on the control plane)
# 32+ chars; presented by the controller
# SUBSTRATE_DATA_WORKER_TOKEN=
# SUBSTRATE_DATA_TICKET_PUBLIC_KEY_FILE=.workspace/keys/ticket.pub.pem
# SUBSTRATE_DATA_WORKER_MEMORY_LIMIT=4GB
# default: all cores
# SUBSTRATE_DATA_WORKER_THREADS=
# SUBSTRATE_DATA_WORKER_CONCURRENCY=4
# A batch job past this is stopped; 0 = half the worker's memory
# SUBSTRATE_DATA_WORKER_JOB_MEMORY_MB=0
# Result cache per worker, MiB (0 disables)
# SUBSTRATE_DATA_WORKER_RESULT_CACHE_MB=128
# inference workers only
# SUBSTRATE_DATA_EMBEDDING_URL=
# SUBSTRATE_DATA_EMBEDDING_MODEL=

# --- catalog database. SQLite by default; set a URL for PostgreSQL (docs/OPERATIONS.md). Off this machine it must
# carry sslmode=verify-full (or verify-ca, require)
# SUBSTRATE_DATA_METADATA_URL=postgresql://substrate:secret@db.example.eu:5432/substrate?sslmode=verify-full
# SUBSTRATE_DATA_METADATA_POOL_SIZE=16

# --- transport security (docs/SECURITY.md). Plaintext is refused on any non-loopback address.
# SUBSTRATE_DATA_TLS_CERT_FILE=/etc/substrate-data/tls/server.crt
# SUBSTRATE_DATA_TLS_KEY_FILE=/etc/substrate-data/tls/server.key
# Require client certificates signed by this CA (mutual TLS)
# SUBSTRATE_DATA_TLS_CLIENT_CA_FILE=/etc/substrate-data/tls/clients-ca.pem
# SUBSTRATE_DATA_TLS_MIN_VERSION=1.3
# Set instead of certificates only if a proxy or service mesh you run terminates TLS in front of this process
# SUBSTRATE_DATA_BEHIND_TLS_PROXY=false
# Audit and statement history older than this is deleted; 0 keeps it
# SUBSTRATE_DATA_HISTORY_RETENTION_DAYS=365

# --- access policies, fair use, credential vending, controller HA (docs/OPERATIONS.md)
# Required to create `hash` column masks; changing it changes every hash
# SUBSTRATE_DATA_MASK_SALT=
# SUBSTRATE_DATA_RATE_LIMIT_PER_MINUTE=1200
# SUBSTRATE_DATA_MAX_CONCURRENT_STATEMENTS=16
# SUBSTRATE_DATA_MAX_CONCURRENT_STATEMENTS_PER_TENANT=64
# SUBSTRATE_DATA_DAILY_SCAN_BYTES_PER_PRINCIPAL=0
# STS role the control plane assumes per statement; SQL workers then need no storage key
# SUBSTRATE_DATA_STORAGE_STS_ROLE_ARN=
# Several controllers, one active: a PostgreSQL database separate from the catalog's
# SUBSTRATE_DATA_CONTROLLER_STATE_URL=postgresql://substrate:secret@db.example.eu/controller?sslmode=verify-full
# Mutual TLS between API, controller and workers: how this process presents itself to the others
# SUBSTRATE_DATA_INTERNAL_CA_FILE=
# SUBSTRATE_DATA_INTERNAL_CERT_FILE=
# SUBSTRATE_DATA_INTERNAL_KEY_FILE=

# --- agent-substrate (code interpreter) on another machine; see docs/AGENTS.md
# JSON list. agent-substrate serves its public keys at /.well-known/data-token-jwks.json
# SUBSTRATE_DATA_TRUSTED_ISSUERS=[{"issuer":"agent-substrate","audience":"substrate-data","jwks_uri":"https://agents.example.eu/.well-known/data-token-jwks.json"}]

# --- web UI (backend-for-frontend)
WEB_PUBLIC_URL=http://127.0.0.1:3011
WEB_CLIENT_SECRET=
# 32+ chars
WEB_SESSION_SECRET=
